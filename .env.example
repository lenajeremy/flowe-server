POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflow_ai
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FRONTEND_URL=http://localhost:5173
AUTH_FROM_EMAIL=Flowe <noreply@example.com>
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# One Atlassian app backs both Jira and Confluence (they differ only in scope).
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Bitbucket has its own OAuth consumer, with scopes fixed in workspace settings.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
# Airtable OAuth requires PKCE; the token endpoint uses Basic auth.
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
# ClickUp tokens do not expire and its OAuth has no scopes.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
# Calendly's booking endpoints require the customer to be on a paid plan.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Dropbox needs token_access_type=offline for a refresh token (set in code).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Netlify has no OAuth scopes and its tokens never expire.
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
# Supabase Connect requires PKCE; the token endpoint uses Basic auth.
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
# Search Console and Contacts reuse GOOGLE_CLIENT_ID; add the webmasters and
# contacts scopes to that OAuth app.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Front uses Basic auth on its OAuth endpoints.
FRONT_CLIENT_ID=
FRONT_CLIENT_SECRET=
