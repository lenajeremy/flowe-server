POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflow_ai
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FRONTEND_URL=http://localhost:5173
# Public origins used in provider configuration. OAUTH_REDIRECT_BASE builds
# OAuth callback URLs; PUBLIC_BASE_URL builds inbound webhook/setup URLs and may
# use a stable custom domain even when OAuth callbacks retain an older domain.
OAUTH_REDIRECT_BASE=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
AUTH_FROM_EMAIL=Flowe <noreply@example.com>
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Slack OAuth is used both by Slack workflow nodes and hosted workflow agents.
# Configure these two public Slack app endpoints:
#   Events API:       POST {PUBLIC_BASE_URL}/api/agent-hosts/slack/events
#   Interactivity:    POST {PUBLIC_BASE_URL}/api/agent-hosts/slack/interactions
# Subscribe the bot to app_mention events. Existing connections must reconnect
# after enabling hosted agents so Slack grants app_mentions:read, thread history
# and chat:write.customize for the deployment's visible agent name.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Public slug from https://github.com/settings/apps/{slug}. This is validated
# before the server returns an installation URL to the frontend. Configure the
# GitHub App's Setup URL as:
#   {PUBLIC_BASE_URL}/api/integrations/github/setup/callback
# Its OAuth callback remains:
#   {OAUTH_REDIRECT_BASE}/api/integrations/github/callback
GITHUB_APP_SLUG=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Stripe OAuth for the Stripe INTEGRATION — lets a workflow act on the customer's
# own Stripe account. Nothing to do with billing them; see STRIPE_SECRET_KEY below.
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# One Atlassian app backs both Jira and Confluence (they differ only in scope).
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
# Bitbucket has its own OAuth consumer, with scopes fixed in workspace settings.
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=
# Airtable OAuth requires PKCE; the token endpoint uses Basic auth.
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
# ClickUp tokens do not expire and its OAuth has no scopes.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
TYPEFORM_CLIENT_ID=
TYPEFORM_CLIENT_SECRET=
# Calendly's booking endpoints require the customer to be on a paid plan.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Dropbox needs token_access_type=offline for a refresh token (set in code).
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Netlify has no OAuth scopes and its tokens never expire.
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=
# Supabase Connect requires PKCE; the token endpoint uses Basic auth.
SUPABASE_CLIENT_ID=
SUPABASE_CLIENT_SECRET=
GUMROAD_CLIENT_ID=
GUMROAD_CLIENT_SECRET=
# Search Console and Contacts reuse GOOGLE_CLIENT_ID; add the webmasters and
# contacts scopes to that OAuth app.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Front uses Basic auth on its OAuth endpoints.
FRONT_CLIENT_ID=
FRONT_CLIENT_SECRET=

# ── Coding agents (Codex in Daytona) ─────────────────────────────
# Coding agents fail closed unless both encryption and Daytona are configured.
# Generate TOKEN_ENC_KEY once (32 random bytes, base64), store it durably, and
# never rotate it without reconnecting every encrypted integration credential.
TOKEN_ENC_KEY=
# Daytona API key with sandbox read/write/delete permissions. Per-sandbox domain
# allowlists require a Daytona tier that supports custom network policies.
DAYTONA_API_KEY=
# Optional for self-hosted Daytona or an explicit region/target.
DAYTONA_API_URL=
DAYTONA_TARGET=
# Optional snapshot with Node.js, git, and the pinned Codex CLI preinstalled.
# Without one, Fernary uses node:22-bookworm and installs Codex in each sandbox.
DAYTONA_CODING_AGENT_SNAPSHOT=
# Keep this pinned. Both device login and task execution use the same version.
CODEX_CLI_VERSION=0.149.1

# ── Billing: our own subscriptions ────────────────────────────────
#
# Distinct from STRIPE_CLIENT_ID/SECRET above, which is the Stripe integration
# acting on a customer's account. These sell OUR plans and must be the platform
# account's own credentials.
#
# Leave unset to run without billing: usage is still measured and nothing is
# charged, which is the normal state for a dev server.
STRIPE_SECRET_KEY=
# From the webhook endpoint in the Stripe dashboard (whsec_...). Without it every
# webhook is rejected — verification is never skipped for a missing secret.
STRIPE_WEBHOOK_SECRET=
# Recurring price ids (price_...). Amounts live in Stripe so a price change needs
# no deploy and existing subscribers keep what they signed up at.
#
# PRO is flat monthly. TEAM is PER SEAT (recurring.usage_type=licensed), billed on
# the subscription quantity — which also drives the credit allowance, because seats
# on their own meter nothing we actually spend.
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
#
# Both prices MUST be created in the account's settlement currency. Location-based
# pricing is Stripe Adaptive Pricing, which converts only FROM that currency — a
# price in anything else falls outside the mechanism and every customer sees the
# original amount. This account settles in EUR, so the prices are in EUR; check
# GET /v1/account default_currency before creating prices for a different account.
#
# Adaptive Pricing is also an ACCOUNT SETTING, not an API parameter: switch it on
# per mode at dashboard.stripe.com/settings/adaptive-pricing.
#
# Do not add currency_options to these prices — an explicit price for a currency
# turns automatic conversion off for that market.
#
# The Customer Portal needs subscription_update ENABLED with both products listed,
# or "switch plan" is a dead end: the portal shows only cancel and card management,
# and a downgrade cannot be performed at all. Set once per mode, via the API or
# dashboard.stripe.com/settings/billing/portal. Note the API does not echo the
# products array back on retrieve, so verify by opening a real portal session and
# looking for "Update subscription" rather than by reading the configuration.
#
# Also set proration_behavior=create_prorations, so a mid-period switch credits the
# unused part instead of charging twice for the same days, and allow `quantity` if
# Team's seat count should be adjustable there.
#
# Webhook endpoint to register: POST {API_URL}/api/billing/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created,
#         customer.subscription.updated, customer.subscription.deleted, invoice.paid

# Shared signing secret for the GitHub App's webhook. Set the same value in the
# App's settings (Webhook → Secret). Our GitHub connection is a GitHub App, so
# events arrive at one app-level URL rather than per-repository hooks — this is
# the only thing that authenticates them. Unset means the endpoint rejects
# everything, which is the intended failure.
GITHUB_WEBHOOK_SECRET=
