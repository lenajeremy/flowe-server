{
  "uid": "flowe-toolcalls",
  "title": "Flowe · Tool Calls",
  "tags": ["flowe", "calls", "integrations"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "workflow",
        "label": "Workflow",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "description": "Filter every panel by workflow name or id (blank = all)"
      },
      {
        "name": "run",
        "label": "Run id",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "description": "Narrow to a single run (blank = all)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "What is being called",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Node calls (selection)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"flowe-server\"} |= `node call` |= `$workflow` |= `$run` [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed calls",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"flowe-server\"} |= `node call` |= `status=error` |= `$workflow` |= `$run` [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Outbound 4xx/5xx",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"flowe-server\"} |= `outbound http` |~ `status=(4|5)[0-9][0-9]` |= `$workflow` |= `$run` [$__range]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Integration calls by provider",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(flowe_integration_calls_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failing operations (provider · op)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 12, "lineWidth": 2, "showPoints": "never" }, "unit": "reqps" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, operation) (rate(flowe_integration_calls_total{status=\"error\"}[5m]))",
          "legendFormat": "{{provider}} · {{operation}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Every call, end to end",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Node calls — caller, arguments, result",
      "description": "One line per node execution: the workflow and run that called it, the operation, the arguments (secrets redacted) and the result or error. Expand a line to see every field.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 11 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"flowe-server\"} |= `node call` |= `$workflow` |= `$run`"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Endpoints reached — method, host, path, status",
      "description": "Every outbound HTTP call any node made, attributed back to its workflow, run and node.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 22 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"flowe-server\"} |= `outbound http` |= `$workflow` |= `$run`"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Failures only",
      "description": "Calls that errored or came back 4xx/5xx — start here when something is broken.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"flowe-server\"} |~ `node call|outbound http` |~ `status=error|status=(4|5)[0-9][0-9]` |= `$workflow` |= `$run`"
        }
      ]
    }
  ]
}
